# Copy to .env.local and fill in. Both files are gitignored — never commit
# real keys. The Ask Me feature (/api/ask) is disabled (returns 503) when
# these are unset, so local docs development works fine without them.

# Portkey API key (https://app.portkey.ai → API Keys). Set a spend cap on the
# virtual key in Portkey — it is the real backstop against cost abuse since
# the route's rate limiting is best-effort.
PORTKEY_API_KEY=

# Portkey virtual key id routing to the Ask Me model (see lib/ai/config.ts
# for the model and docs/lib/ai/PORTKEY_PROMPT.md for setup notes).
PORTKEY_VIRTUAL_KEY=
